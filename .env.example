# Copy to .env and fill in. Never commit .env.
# docker compose reads this file. For running the server outside Docker, export the REF_* names.

# Required. Choose any strong value; used by the db and api services.
POSTGRES_PASSWORD=change-me

# Optional
# local | ci | production. Production makes session cookies Secure (needs TLS).
REF_ENVIRONMENT=local
REF_LOG_LEVEL=INFO
# REF_SESSION_TTL_HOURS=168
# REF_INVITE_TTL_HOURS=72
# Overrides the environment-based cookie default.
# REF_COOKIE_SECURE=true
# production refuses to start with REF_COOKIE_SECURE=false.

# Hosted mode (TLS): see docs/deployment.md. Set the public name and start with both files:
#   REF_DOMAIN=ref.example.org docker compose -f docker-compose.yml -f docker-compose.hosted.yml up -d
# REF_DOMAIN=ref.example.org

# Rate limits (defaults shown; the ingest ones are ADR-005's). Per user unless noted.
# REF_INGEST_PER_MINUTE=60        REF_INGEST_BURST=20     # POST /events and the frame upload
# REF_TOKEN_PER_MINUTE=30         REF_TOKEN_BURST=10      # other extension requests
# REF_DASHBOARD_PER_MINUTE=300    REF_DASHBOARD_BURST=60
# REF_DESTRUCTIVE_PER_MINUTE=10   REF_DESTRUCTIVE_BURST=5 # every DELETE
# REF_API_IP_PER_MINUTE=600       REF_API_IP_BURST=120    # every /api/ request, per address
# REF_AUTH_IP_PER_MINUTE=20       REF_AUTH_IP_BURST=10    # login and register, per address
# REF_LOGIN_FAILURES_PER_EMAIL=5  REF_LOGIN_FAILURE_REFILL_SECONDS=180
# REF_PASSWORD_CONCURRENCY=4      # simultaneous argon2 hashes or checks (64 MiB each)
# Networks whose X-Forwarded-For is believed (your reverse proxy). Empty: the peer is the client.
# Compose sets the private ranges. Never list a network clients can reach directly.
# REF_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Server outside Docker only (compose builds this itself):
# REF_DATABASE_URL=postgresql+psycopg://ref:change-me@127.0.0.1:5432/ref
# REF_FRAME_STORE_DIR=./frames
# REF_FRAME_TTL_HOURS=24
# REF_FRAME_SWEEP_INTERVAL_SECONDS=900

# Tests that need a real database (pytest -m db):
# TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:55432/ref_test
