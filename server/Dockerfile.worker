# Build from the repository root: docker build -f server/Dockerfile.worker .
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv

WORKDIR /srv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/srv/.venv/bin:$PATH"

COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --frozen --no-dev --group ml

COPY server/alembic.ini ./
COPY server/app ./app
COPY server/migrations ./migrations
COPY taxonomy /srv/taxonomy

RUN useradd --system --uid 10001 ref && mkdir -p /var/lib/ref/frames /var/lib/ref/embeddings /var/lib/ref/models && chown -R ref /var/lib/ref
USER ref

ENV REF_TAXONOMY_FILE=/srv/taxonomy/topics.json
# Worker: waits for jobs, processes Reels, rebuilds fingerprints.
CMD ["python", "-m", "app.worker"]
